APP_NAME=GESCOLA API
ENVIRONMENT=development

# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://gescola_app:CHANGE_ME@localhost:5432/gescola_dev

# Générer une valeur forte en production, ex: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_DO_NOT_USE_IN_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_MIN_LENGTH=10

# Liste JSON des origines autorisées pour le frontend
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

LOGIN_RATE_LIMIT=5/minute
